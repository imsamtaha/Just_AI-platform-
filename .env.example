# Database
DATABASE_URL="postgresql://username:password@localhost:5432/sam_ai"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase (JUST AI agent persistence)
# Configure Clerk as a Supabase Third-Party Auth provider.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# JUST AI Agent
# When true, requests routed to multiple skills run specialist calls in parallel,
# then a lead-agent synthesis call. Set false to reduce model usage/cost.
JUST_AI_MULTI_AGENT_ENABLED=true
# When true, clear real-action requests can be converted into external tool plans.
# Write and consequential plans still require explicit user approval before execution.
JUST_AI_TOOL_PLANNER_ENABLED=true

# JUST AI External Tools
# GitHub read works for public allow-listed repos without a token.
# A token is required for GitHub write actions such as issue creation.
JUST_AI_GITHUB_ALLOWED_REPOS=imsamtaha/Just_AI-platform-
GITHUB_AGENT_TOKEN=

# Optional fixed server-side connector endpoints. Write/consequential actions
# always require an explicit approval request before execution.
JUST_AI_CONNECTOR_SECRET=
JUST_AI_CALENDAR_CONNECTOR_URL=
JUST_AI_CRM_CONNECTOR_URL=
JUST_AI_AUTOMATION_CONNECTOR_URL=

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# UploadThing
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=sam-ai-storage
